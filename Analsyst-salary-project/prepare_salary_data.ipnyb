        "tags": [],
        "id": "sQA6Dp4EulEjstvo5NDZSnNT"
      },
      "source": [
        "# primary dataset\n",
        "file_path = 'gs://data-analyst-wage-trends/prim/gsearch_jobs.csv'\n",
        "data_jobs = pd.read_csv(file_path, encoding='latin-1')\n",
        "\n",
        "# supplementary dataset\n",
        "file_path2 = 'gs://data-analyst-wage-trends/suppl-1/cost_of_living_us.csv'\n",
        "cost_living = pd.read_csv(file_path2, encoding='latin-1')"
      ],
      "execution_count": 2,
      "outputs": []
    },
    {
